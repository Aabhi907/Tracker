{
  "name": "cartoon3d-shorts",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/bridge-stills.mjs",
    "render": "remotion render src/index.ts BridgeShort out/bridge/video.mp4 --codec h264 --crf 16 --gl=angle",
    "render2k": "remotion render src/index.ts BridgeShort out/bridge/video_2k.mp4 --codec h264 --crf 16 --scale 1.3333 --gl=angle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.290",
    "@remotion/cli": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "@remotion/three": "4.0.290",
    "postprocessing": "6.37.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  }
}
